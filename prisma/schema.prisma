generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  role          String    @default("user") // "user", "admin", "employee"
  status        String    @default("active") // "active", "suspended"
  companyName   String?   @map("company_name")
  phone         String?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  products      Product[]
  planRequests  PlanRequest[]
  employees     Employee[]
  activeSessions ActiveSession[]
  activityLogs  ActivityLog[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Employee {
  id             String   @id @default(cuid())
  ownerId        String   @map("owner_id")
  employeeEmail  String   @map("employee_email")
  employeeName   String?  @map("employee_name")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("employees")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Custom Data Models
model Product {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  sku           String
  title         String   @db.Text
  description   String?  @db.Text
  category      String?
  mainImage     String?  @map("main_image")
  externalLink  String?  @db.Text @map("external_link")
  variations    Json?    // e.g., sizes, colors
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skus          Sku[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model Sku {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  userId        String   @map("user_id")
  skuCode       String   @map("sku_code")
  
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("skus")
}

model Plan {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  price         Decimal  @db.Decimal(10, 2)
  billingCycle  String   @map("billing_cycle") // "monthly", "yearly"
  features      Json?
  maxProducts   Int      @map("max_products") @default(-1)
  maxSkus       Int      @map("max_skus") @default(-1)
  maxImages     Int      @map("max_images") @default(-1)
  maxDevices    Int      @map("max_devices") @default(-1)
  maxEmployees  Int      @map("max_employees") @default(-1)
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

model ActivityLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  action        String
  details       Json?
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model PlanRequest {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  planName      String   @map("plan_name")
  status        String   @default("pending") // "pending", "approved", "rejected"
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("plan_requests")
}

model ContactMessage {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  subject       String?
  message       String   @db.Text
  isRead        Boolean  @default(false) @map("is_read")

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}


model SeoSetting {
  id              String   @id @default(cuid())
  path            String   @unique
  title           String?  @db.Text
  description     String?  @db.Text
  keywords        String?  @db.Text
  ogTitle         String?  @map("og_title")
  ogDescription   String?  @map("og_description")
  ogImage         String?  @map("og_image")
  facebookPixelId String?  @map("facebook_pixel_id")
  ga4Id           String?  @map("ga4_id")
  headTags        String?  @db.Text @map("head_tags")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("seo_settings")
}


model ActiveSession {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  device        String?
  browser       String?
  os            String?
  ipAddress     String?  @map("ip_address")
  lastActive    DateTime @default(now()) @map("last_active")
  isCurrent     Boolean  @default(false) @map("is_current")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("active_sessions")
}

model PlatformSetting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         Json
  description   String?

  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

model Popup {
  id            String   @id @default(cuid())
  name          String
  content       Json
  isActive      Boolean  @default(false) @map("is_active")
  displayRules  Json     @map("display_rules")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("popups")
}
